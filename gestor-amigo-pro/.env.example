# Copie para .env (local) ou configure nas variáveis de ambiente da Vercel.
# NUNCA versione o arquivo .env preenchido.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor (Vercel → Environment Variables → Production; NÃO marcar Preview):
LOVABLE_API_KEY=
# Opcional — só se algum server function precisar ignorar RLS (hoje não é usado):
# SUPABASE_SERVICE_ROLE_KEY=

# Blindagem
VITE_EXIGIR_MFA=true
VITE_INATIVIDADE_MIN=30
