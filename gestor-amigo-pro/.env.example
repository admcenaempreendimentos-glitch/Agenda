# Copie para .env (local) ou configure nas variáveis de ambiente da Vercel.
# NUNCA versione o arquivo .env preenchido.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor (Vercel → Environment Variables → Production; NÃO marcar Preview):
LOVABLE_API_KEY=
# Opcional — só se algum server function precisar ignorar RLS (hoje não é usado):
# SUPABASE_SERVICE_ROLE_KEY=

# Blindagem
# Cadastro de MFA obrigatório para todos (ative SOMENTE após habilitar TOTP em Supabase → Authentication → Multi-Factor):
VITE_EXIGIR_MFA=true
# Servidor: a API do assistente exige token com segundo fator (aal2). Use "false" para desativar temporariamente.
EXIGIR_MFA=true
VITE_INATIVIDADE_MIN=30

# Fase 1 do Carl — busca na internet com fontes (Tavily, 1.000 buscas/mês grátis)
# Crie a chave em https://app.tavily.com e configure SOMENTE em Production na Vercel.
# Sem ela, o Carl continua funcionando e avisa que não pode pesquisar.
TAVILY_API_KEY=
